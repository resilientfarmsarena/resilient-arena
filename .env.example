# Copy to .env.local for local development, and set the same values in
# the Vercel dashboard under Settings > Environment Variables.
#
# Nothing in here is ever sent to the browser. The pages call this site's
# own /api endpoints, and those endpoints attach the token server side.

# Airtable personal access token.
# Needs read access to the boarding base and write access to the hiring
# base. Leave it unset and the site still runs: the map falls back to its
# built-in sample pens, the Available Pens figure shows "-", and the two
# forms report success without saving.
AIRTABLE_TOKEN=

# Base IDs. Defaults are baked into api/_airtable.js; override only to
# point a preview deployment at a different base.
# AIRTABLE_BOARDING_BASE=appww5dZtWrtQJiqu
# AIRTABLE_HIRING_BASE=appEh5qi4D2stYTFe

# Table overrides. Defaults match the live bases.
# AIRTABLE_PENS_TABLE=Stalls, Traps, Pastures
# AIRTABLE_AVAIL_TABLE=Stalls, Traps, Pastures
# AIRTABLE_RESERVATIONS_TABLE=Arena Reservations
# AIRTABLE_CANDIDATES_TABLE=tbl1mKpAjKxyX47Wn

# Event rental is built but not offered. Set to true only when it opens,
# and flip SHOW_EVENT_RENTAL in index.html to match. While this is unset
# the server rejects event bookings even if a request asks for one.
# SHOW_EVENT_RENTAL=false

# ---------------------------------------------------------------------
# RESUMES
# ---------------------------------------------------------------------
# Resumes go straight into the Resume attachment field on Arena
# Candidates. No file host is involved and nothing needs configuring:
# the field ID is already the default in api/apply.js.
#
# Ceiling on the file. Airtable's upload route allows 5 MB of base64, but
# a Vercel function body caps at 4.5 MB and base64 adds about a third, so
# 3 MB of file is the real limit. Keep in step with MAX_FILE_BYTES on the
# hiring page if you change it.
# RESUME_MAX_BYTES=3145728

# Only set if the Resume column is ever rebuilt and gets a new ID.
# AIRTABLE_RESUME_FIELD_ID=fld1euct1XuSwUas5

# ---------------------------------------------------------------------
# RESUME RETENTION (cron, /api/retention, daily at 04:00 UTC)
# ---------------------------------------------------------------------
# Vercel sends this as a bearer token on cron requests. Set it, or the
# endpoint is a public delete button.
# CRON_SECRET=

# Resumes of candidates who were not hired are cleared this many months
# after they applied. Hired candidates are left alone.
# RESUME_RETENTION_MONTHS=12
# AIRTABLE_HIRED_STATUS=Hired

# Column names used by the retention formula (filterByFormula addresses
# columns by name, not by field ID).
# AIRTABLE_APPLIED_ON_NAME=Applied On
# AIRTABLE_STATUS_NAME=Status
# AIRTABLE_RESUME_NAME=Resume

# ---------------------------------------------------------------------
# MAP DETAIL SHEET
# ---------------------------------------------------------------------
# AIRTABLE_INQUIRIES_TABLE=Pen Requests
# AIRTABLE_WAITLIST_TABLE=Pen Waitlist

# ---------------------------------------------------------------------
# CONTACT FORM
# ---------------------------------------------------------------------
# AIRTABLE_CONTACT_TABLE=Contact Inquiries

# ---------------------------------------------------------------------
# WAITLIST TEXTS (Twilio) - cron, /api/notify-waitlist, every 15 minutes
# ---------------------------------------------------------------------
# Every 15 minutes needs a Vercel Pro plan. Hobby caps crons at once per
# day, which would make "first to reach us gets it" a lottery. On Hobby,
# change the schedule in vercel.json to "0 * * * *" and it will fail the
# deploy, or to a daily time and accept the delay.
#
# From the Twilio console: Account SID and Auth Token.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# One of these. A Messaging Service is the better choice: it is what the
# A2P 10DLC campaign attaches to, and it handles STOP/HELP for you.
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_FROM_NUMBER=+13256273726

# Number the text tells people to call. Shown in the message body.
# ARENA_PHONE=(325) 627-3726

# Override the whole message. {pen} is replaced with the pen name.
# WAITLIST_SMS_TEMPLATE=

# Safety cap per run.
# WAITLIST_MAX_PER_RUN=200

# ---------------------------------------------------------------------
# STRIPE
# Arena reservation deposits. The secret key and the webhook secret are
# server side only. The publishable key is public by design and is handed
# to the page by /api/stripe-config.
#
# Start with test keys (sk_test_ / pk_test_) and card 4242 4242 4242 4242.
# The page shows a test mode banner whenever the key is a test key.
#
# STRIPE_WEBHOOK_SECRET comes from the endpoint you create in Stripe at
# https://your-domain/api/stripe-webhook listening for
# payment_intent.succeeded, payment_intent.payment_failed, charge.refunded
# ---------------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
